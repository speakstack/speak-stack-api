// Discover all Docker containers on the host
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Filter to speak-stack containers and add labels
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/speak-stack-.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/speak-stack-alloy"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "service"
    replacement  = "speak-stack"
  }

  rule {
    target_label = "env"
    replacement  = "production"
  }
}

// Tail Docker container logs
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.parse_json.receiver]
}

// Parse JSON logs and promote a few low-cardinality fields to labels
loki.process "parse_json" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.json {
    expressions = {
      level   = "level",
      context = "context",
    }
  }

  stage.labels {
    values = {
      level   = "",
      context = "",
    }
  }
}

// Ship to Grafana Cloud Loki
loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username = sys.env("LOKI_USER")
      password = sys.env("LOKI_TOKEN")
    }
  }
}
